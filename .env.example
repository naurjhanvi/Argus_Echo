# Copy this file to .env and fill in the values on your machine.
# Never commit .env or paste its contents into chat.
BOLNA_AGENT_ID=your_bolna_agent_id
BOLNA_API_KEY=your_bolna_api_key
GROQ_API_KEY=your_groq_api_key
ARGUS_VOICEOPS_API_TOKEN=replace_with_a_long_random_secret
ARGUS_BOLNA_WEBHOOK_TOKEN=replace_with_a_different_long_random_secret

# Leave blank for local Docker. Set to your public HTTPS origin when deployed.
ARGUS_VOICEOPS_API_URL=
# Browser origin allowed to call the FastAPI service (local Docker default).
ARGUS_UI_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
